importar sintatico.parser como Par
importar traducao.sqlite.tradutor como TradSql
importar traducao.postgresql.tradutor como TradPg
importar traducao.mysql.tradutor como TradMy
importar conectores.sqlite_conector como ConnSql

funcao afirmar(condicao: logico, msg: texto): vazio {
    se (!condicao) {
        falhar "FALHA TRADUCAO/CONECTOR: " + msg
    }
}

// 1. Comparação de tradução nos 3 dialetos (SQLite, PostgreSQL, MySQL)
const ddl: texto = "CRIAR TABELA SE NÃO EXISTIR clientes (id INTEIRO NAO NULO CHAVE PRIMARIA AUTO INCREMENTO, nome TEXTO(100) NAO NULO, ativo LOGICO NAO NULO);"
var pDdl = Par.AnalisadorSintatico.analisarCodigo(ddl, "", falso)

var tSql = TradSql.TradutorSQLite().traduzir(pDdl.comandos[0])
var tPg = TradPg.TradutorPostgreSQL().traduzir(pDdl.comandos[0])
var tMy = TradMy.TradutorMySQL().traduzir(pDdl.comandos[0])

afirmar(tSql.sql.inclui("CREATE TABLE IF NOT EXISTS clientes") e tSql.sql.inclui("AUTOINCREMENT"), "SQLite DDL incorreto: " + tSql.sql)
afirmar(tPg.sql.inclui("GENERATED BY DEFAULT AS IDENTITY"), "PostgreSQL DDL incorreto: " + tPg.sql)
afirmar(tMy.sql.inclui("AUTO_INCREMENT PRIMARY KEY"), "MySQL DDL incorreto: " + tMy.sql)

// 2. Parâmetros posicionais e nomeados (PostgreSQL converte para $1, $2)
const qParam: texto = "SELECIONAR nome, idade DE clientes ONDE idade >= ? E ativo = :ativo ORDENAR POR nome CRESCENTE LIMITE 5;"
var pQ = Par.AnalisadorSintatico.analisarCodigo(qParam, "", falso)
var rSql = TradSql.TradutorSQLite().traduzir(pQ.comandos[0])
var rPg = TradPg.TradutorPostgreSQL().traduzir(pQ.comandos[0])
var rMy = TradMy.TradutorMySQL().traduzir(pQ.comandos[0])

afirmar(rSql.sql.inclui("idade >= ?") e rSql.sql.inclui("ativo = :ativo"), "SQLite params incorreto: " + rSql.sql)
afirmar(rPg.sql.inclui("idade >= $1") e rPg.sql.inclui("ativo = $2"), "PostgreSQL params incorreto: " + rPg.sql)
afirmar(rMy.sql.inclui("idade >= ?") e rMy.sql.inclui("ativo = ?"), "MySQL params incorreto: " + rMy.sql)

// 3. Execução real de ponta a ponta contra SQLite (:memory:) via ConectorSQLite
var conn = ConnSql.ConectorSQLite(":memory:")
conn.executarLinConEs(ddl)
conn.executarLinConEs("INSERIR EM clientes (nome, ativo) VALORES (?, ?);", ["Pernalonga", verdadeiro])
conn.executarLinConEs("INSERIR EM clientes (nome, ativo) VALORES (?, ?);", ["Patolino", falso])

// Teste de transação e rollback real
conn.iniciarTransacao()
conn.executarLinConEs("INSERIR EM clientes (nome, ativo) VALORES (?, ?);", ["Frajola", verdadeiro])
conn.reverter()

var resSel = conn.executarLinConEs("SELECIONAR nome, ativo DE clientes ONDE ativo = VERDADEIRO;")
afirmar(resSel.linhas.tamanho() == 1, "Esperada 1 linha ativa após rollback, obtido " + texto(resSel.linhas.tamanho()))
afirmar(texto(resSel.linhas[0]["nome"]) == "Pernalonga", "Esperado Pernalonga")

// Introspecção real de catálogo
var cat = conn.introspeccaoCatalogo()
afirmar(cat.existeTabela("clientes"), "Introspecção deve descobrir tabela clientes")
var tabCli = cat.obterTabela("clientes")
afirmar(tabCli.colunas.tamanho() == 3, "Tabela clientes deve ter 3 colunas")

conn.fechar()
escreva("traducao_e_conectores_teste: OK")
